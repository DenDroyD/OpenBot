# Скопируйте эти переменные в Bothost -> Env переменные

# Telegram
BOT_TOKEN=123456789:ABCDEF_your_real_token_here

# EWS (одинаковый для всех пользователей)
EWS_URL=https://mail.ecleasing.ru/ews/exchange.asmx

# Шифрование паролей в базе (ОБЯЗАТЕЛЬНО заполнить)
# Сгенерируйте ключ (пример ниже в инструкции) и вставьте сюда.
DATA_ENCRYPTION_KEY=REPLACE_ME_WITH_FERNET_KEY

# Путь к Excel со списком сотрудников внутри проекта (можно поменять)
